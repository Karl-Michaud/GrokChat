// GrokChat Worker (plan §3.6). Bindings and the three Cron Triggers are declared here; nothing is
// created or deployed before PR 8, which creates the D1 database and the R2 bucket, replaces the
// placeholder database_id, and deploys by hand from a release on main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grokchat",
  "main": "src/main.ts",
  // Pinned to the date of the workerd bundled with @cloudflare/vitest-plugin 1.4.8 (workerd 2026-10-23),
  // so tests and production run the same compatibility behaviour.
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grokchat",
      // Placeholder until PR 8 runs `wrangler d1 create grokchat`. Local tests use a local D1.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT", "class_name": "AccountPublisher" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountPublisher"] }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "grokchat-media" }],
  // scheduled() dispatches by controller.cron (src/frameworks/cron/dispatch.ts, CRONS): publish
  // every minute, reconcile every 10, metrics and the staged-media cleanup every 15. 3 of 5 allowed.
  "triggers": { "crons": ["* * * * *", "*/10 * * * *", "*/15 * * * *"] },
}
