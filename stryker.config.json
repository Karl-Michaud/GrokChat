{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "$comment": "Mutation testing on the pure layers under plain Node (plan §5, A6). Every mutant must be killed: break threshold 100.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.unit.config.ts" },
  "mutate": ["src/entities/**/*.ts", "src/use_cases/**/*.ts", "src/interface_adapters/**/*.ts"],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always"
}
