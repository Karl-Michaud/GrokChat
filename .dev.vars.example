# Copy to .dev.vars (gitignored) for `wrangler dev`. Names only: never put a value in this file.
# Production values are Worker secrets (`wrangler secret put <NAME>`), plan §3.6.

# Secrets
X_CLIENT_ID=
X_CLIENT_SECRET=
GROKCHAT_BOT_CLIENTS=
GROKCHAT_TOKEN_KEYS=
# At least 32 characters.
GROKCHAT_SESSION_SECRET=
# Format: pbkdf2-sha256$100000$<salt>$<hash>, base64url (src/frameworks/web/password.ts).
GROKCHAT_ADMIN_PASSWORD_HASH=

# Vars
# Exactly as browsers send Origin: https://grokchat.<subdomain>.workers.dev, or http://localhost:8787.
GROKCHAT_PUBLIC_ORIGIN=
GROKCHAT_MEDIA_HOSTS=
